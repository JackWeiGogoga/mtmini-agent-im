# Copy to .env.local and fill only the values you need.
# Makefile targets source this file before starting local services.

# Backend
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL='jdbc:mysql://127.0.0.1:3306/mtmini_ai_agent_im?useUnicode=true&characterEncoding=UTF8&autoReconnect=true&allowMultiQueries=true&zeroDateTimeBehavior=convertToNull'
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root123456
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=root123456
SPRING_DATA_REDIS_DATABASE=0

# COS. Keep disabled if you do not test file upload.
# Set COS_ENABLED=true when testing H5 knowledge document upload or sales receipt-code upload.
COS_ENABLED=false
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-beijing
COS_BUCKET=mtmini-receipt-code-1311487792
COS_PUBLIC_ACCESS_URL_BASE=
COS_RECEIPT_CODE_KEY_PREFIX=sales/receipt-code
COS_RECEIPT_CODE_PRIVATE_READ=true
COS_RECEIPT_CODE_ACCESS_URL_EXPIRE_SECONDS=1800
COS_RECEIPT_CODE_MAX_FILE_SIZE=2MB
MT_KNOWLEDGE_DOCUMENT_KEY_PREFIX=knowledge/documents

# Local defaults
SMS_MOCK_ENABLED=true
SCHEDULED_ENABLED=false
POWER_WECHAT_PAY_MOCK_ENABLED=true

# Merchant knowledge RAG
# Embedding uses Alibaba Bailian/DashScope compatible endpoint.
DASHSCOPE_API_KEY=
MT_KNOWLEDGE_EMBEDDING_API_KEY=${DASHSCOPE_API_KEY}
MT_KNOWLEDGE_EMBEDDING_BASE_URL=https://llm-kz8j7o34hwdm6nb4.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MT_KNOWLEDGE_EMBEDDING_MODEL=text-embedding-v4
MT_KNOWLEDGE_EMBEDDING_DIM=1024

# Chat model. Fill this when you want to test AI-assisted knowledge processing.
MT_KNOWLEDGE_MODEL_BASE_URL=https://tokenhub.tencentmaas.com/v1
MT_KNOWLEDGE_MODEL_API_KEY=
MT_KNOWLEDGE_CHAT_MODEL=deepseek-v4-flash

# Meituan IM callback secret. Required for /api/callbacks/meituan/imMsg signature verification.
MT_IM_SECRET=

# Meituan local test values.
MT_DEVELOPER_ID=
MT_SIGN_KEY=
MT_BUSINESS_ID=16
MT_H5_APP_KEY=
