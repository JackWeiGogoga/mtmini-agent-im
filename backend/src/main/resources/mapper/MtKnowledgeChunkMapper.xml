<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gogoga.backend.mapper.MtKnowledgeChunkMapper">
    <resultMap id="BaseResultMap" type="com.gogoga.backend.entity.mt.MtKnowledgeChunk">
        <id column="id" property="id"/><result column="shop_id" property="shopId"/>
        <result column="source_type" property="sourceType"/><result column="source_id" property="sourceId"/>
        <result column="item_id" property="itemId"/><result column="document_id" property="documentId"/>
        <result column="chunk_text" property="chunkText"/><result column="embedding_provider" property="embeddingProvider"/>
        <result column="embedding_model" property="embeddingModel"/><result column="embedding_dim" property="embeddingDim"/>
        <result column="embedding_blob" property="embeddingBlob"/><result column="token_count" property="tokenCount"/>
        <result column="enabled" property="enabled"/><result column="deleted" property="deleted"/>
        <result column="create_time" property="createTime"/><result column="update_time" property="updateTime"/>
    </resultMap>
    <sql id="BaseColumnList">id,shop_id,source_type,source_id,item_id,document_id,chunk_text,embedding_provider,embedding_model,embedding_dim,embedding_blob,token_count,enabled,deleted,create_time,update_time</sql>
    <select id="selectById" resultMap="BaseResultMap">SELECT <include refid="BaseColumnList"/> FROM mt_knowledge_chunk WHERE id=#{id} LIMIT 1</select>
    <select id="selectByIdAndShopId" resultMap="BaseResultMap">SELECT <include refid="BaseColumnList"/> FROM mt_knowledge_chunk WHERE id=#{id} AND shop_id=#{shopId} AND deleted=0 LIMIT 1</select>
    <select id="selectByDocumentIdAndShopId" resultMap="BaseResultMap">SELECT <include refid="BaseColumnList"/> FROM mt_knowledge_chunk WHERE document_id=#{documentId} AND shop_id=#{shopId} AND deleted=0 ORDER BY id</select>
    <select id="selectSearchCandidates" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumnList"/> FROM mt_knowledge_chunk
        WHERE shop_id=#{shopId} AND enabled=1 AND deleted=0
        AND embedding_provider=#{embeddingProvider} AND embedding_model=#{embeddingModel}
        AND embedding_dim=#{embeddingDim} AND embedding_blob IS NOT NULL
        ORDER BY CASE WHEN source_type='QA' THEN 0 ELSE 1 END, id DESC LIMIT #{limit}
    </select>
    <select id="countAvailableByShopId" resultType="int">SELECT COUNT(1) FROM mt_knowledge_chunk WHERE shop_id=#{shopId} AND enabled=1 AND deleted=0</select>
    <insert id="insert" parameterType="com.gogoga.backend.entity.mt.MtKnowledgeChunk" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO mt_knowledge_chunk (shop_id,source_type,source_id,item_id,document_id,chunk_text,embedding_provider,embedding_model,embedding_dim,embedding_blob,token_count,enabled,deleted,create_time,update_time)
        VALUES (#{shopId},#{sourceType},#{sourceId},#{itemId},#{documentId},#{chunkText},#{embeddingProvider},#{embeddingModel},#{embeddingDim},#{embeddingBlob},#{tokenCount},#{enabled},#{deleted},#{createTime},#{updateTime})
    </insert>
    <insert id="insertBatch">
        INSERT INTO mt_knowledge_chunk (shop_id,source_type,source_id,item_id,document_id,chunk_text,embedding_provider,embedding_model,embedding_dim,embedding_blob,token_count,enabled,deleted,create_time,update_time) VALUES
        <foreach collection="chunks" item="chunk" separator=",">(#{chunk.shopId},#{chunk.sourceType},#{chunk.sourceId},#{chunk.itemId},#{chunk.documentId},#{chunk.chunkText},#{chunk.embeddingProvider},#{chunk.embeddingModel},#{chunk.embeddingDim},#{chunk.embeddingBlob},#{chunk.tokenCount},#{chunk.enabled},#{chunk.deleted},#{chunk.createTime},#{chunk.updateTime})</foreach>
    </insert>
    <update id="disableBySource">UPDATE mt_knowledge_chunk SET enabled=0,deleted=1,update_time=#{updateTime} WHERE source_type=#{sourceType} AND source_id=#{sourceId}</update>
    <update id="updateEnabledByIdAndShopId">UPDATE mt_knowledge_chunk SET enabled=#{enabled},update_time=#{updateTime} WHERE id=#{id} AND shop_id=#{shopId} AND deleted=0</update>
    <update id="softDeleteByIdAndShopId">UPDATE mt_knowledge_chunk SET deleted=1,enabled=0,update_time=#{updateTime} WHERE id=#{id} AND shop_id=#{shopId}</update>
    <update id="softDeleteByShopId">UPDATE mt_knowledge_chunk SET deleted=1,enabled=0,update_time=#{updateTime} WHERE shop_id=#{shopId} AND deleted=0</update>
</mapper>
