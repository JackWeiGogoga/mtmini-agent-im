<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gogoga.backend.mapper.RoleMenuMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.gogoga.backend.entity.RoleMenu">
        <id column="id" property="id"/>
        <result column="role_id" property="roleId"/>
        <result column="menu_id" property="menuId"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <!-- 插入角色菜单关联 -->
    <insert id="insert" parameterType="com.gogoga.backend.entity.RoleMenu" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_role_menu (role_id, menu_id)
        VALUES (#{roleId}, #{menuId})
    </insert>

    <!-- 批量插入角色菜单关联 -->
    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO ai_role_menu (role_id, menu_id) VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.roleId}, #{item.menuId})
        </foreach>
    </insert>

    <!-- 根据角色ID删除关联 -->
    <delete id="deleteByRoleId">
        DELETE FROM ai_role_menu WHERE role_id = #{roleId}
    </delete>

    <!-- 根据菜单ID删除关联 -->
    <delete id="deleteByMenuId">
        DELETE FROM ai_role_menu WHERE menu_id = #{menuId}
    </delete>

    <!-- 根据角色ID查询菜单ID列表 -->
    <select id="selectMenuIdsByRoleId" resultType="java.lang.String">
        SELECT menu_id FROM ai_role_menu WHERE role_id = #{roleId}
    </select>

    <!-- 根据菜单ID查询角色ID列表 -->
    <select id="selectRoleIdsByMenuId" resultType="java.lang.String">
        SELECT role_id FROM ai_role_menu WHERE menu_id = #{menuId}
    </select>

</mapper>
