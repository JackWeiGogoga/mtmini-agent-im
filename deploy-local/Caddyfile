aiadmin.waimaidashi.com {
	log {
		output file /var/log/caddy/aiadmin-access.log
		format console
	}

	import common_security

	handle /api/* {
		request_body {
			max_size 10MB
		}

		reverse_proxy 127.0.0.1:8080
	}

	handle {
		root * /var/www/mt-admin
		try_files {path} /index.html
		file_server
	}
}

aiapi.waimaidashi.com {
	log {
		output file /var/log/caddy/aiapi-access.log
		format console
	}

	import common_security

	@callbackBadMethod {
		path /api/callbacks/*
		not path /api/callbacks/youzan/app
		not method POST
	}
	@youzanCallbackBadMethod {
		path /api/callbacks/youzan/app
		not method GET
	}
	respond @callbackBadMethod 405
	respond @youzanCallbackBadMethod 405

	handle /api/* {
		request_body {
			max_size 2MB
		}

		reverse_proxy 127.0.0.1:8080
	}

	handle {
		respond "Not Found" 404
	}
}
