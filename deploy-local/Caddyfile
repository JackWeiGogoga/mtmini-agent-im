(common_security) {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=()"
		-Server
	}

	@badMethod not method GET POST OPTIONS
	respond @badMethod 405

	@blockedFiles path /.env /.env.* /.git* /Caddyfile /Dockerfile /docker-compose* /package.json /package-lock.json /pnpm-lock.yaml /yarn.lock
	respond @blockedFiles 404

	@swagger path /swagger-ui/* /v3/api-docs/*
	respond @swagger 404
}

aib.waimaidashi.com {
	log {
		output file /var/log/caddy/aib-access.log
		format console
	}

	import common_security

	handle /api/* {
		request_body {
			max_size 10MB
		}

		reverse_proxy 127.0.0.1:8080
	}

	handle {
		root * /var/www/mt-h5
		try_files {path} /index.html
		file_server
	}
}

aibadmin.waimaidashi.com {
	log {
		output file /var/log/caddy/aibadmin-access.log
		format console
	}

	import common_security

	handle /api/* {
		request_body {
			max_size 10MB
		}

		reverse_proxy 127.0.0.1:8080
	}

	handle {
		root * /var/www/mt-admin
		try_files {path} /index.html
		file_server
	}
}

aibapi.waimaidashi.com {
	log {
		output file /var/log/caddy/aibapi-access.log
		format console
	}

	import common_security

	@callbackBadMethod {
		path /api/callbacks/*
		not path /api/callbacks/youzan/app
		not method POST
	}
	@youzanCallbackBadMethod {
		path /api/callbacks/youzan/app
		not method GET
	}
	respond @callbackBadMethod 405
	respond @youzanCallbackBadMethod 405

	handle /api/* {
		request_body {
			max_size 2MB
		}

		reverse_proxy 127.0.0.1:8080
	}

	handle {
		respond "Not Found" 404
	}
}
